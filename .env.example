# Skopiuj ten plik jako .env i dostosuj wartości.
#   cp .env.example .env
#
# Docker Compose czyta .env automatycznie (podstawienia HOST_PORT,
# SESSION_SECRET), a uruchomienie lokalne wczytuje go przez dotenv.

# ---------------------------------------------------------------------------
# Serwer
# ---------------------------------------------------------------------------

# PORT: port nasłuchu aplikacji.
# Większość platform PaaS (Cloud Run, Fly, Render) wstrzykuje go sama.
# W Compose port kontenera jest stały, a mapowanie zmieniasz przez HOST_PORT.
PORT=3000

# SESSION_SECRET: podpisuje tokeny tożsamości uczestników (HMAC-SHA256).
# Puste lub brak = losowy sekret generowany przy każdym starcie procesu.
#
# Przy obecnym stanie trzymanym w pamięci ma to niewielkie znaczenie: restart
# i tak kasuje wszystkie pokoje, więc nie ma do czego wracać. Ustaw go, jeśli
# kiedykolwiek dojdzie trwały stan albo druga instancja za load balancerem.
#
# Wygenerowanie wartości:
#   openssl rand -hex 32
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Docker Compose
# ---------------------------------------------------------------------------

# HOST_PORT: port na hoście mapowany na port 3000 w kontenerze.
HOST_PORT=3000

# ---------------------------------------------------------------------------
# Pozostałości po szkielecie z AI Studio
# ---------------------------------------------------------------------------
# Żadna z poniższych zmiennych nie jest obecnie odczytywana przez aplikację.
# Zostawione do czasu decyzji, czy projekt pójdzie w stronę integracji z AI.

# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
